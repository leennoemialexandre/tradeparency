# Tradeparency environment variables
#
# Tradeparency works with zero configuration: if the Supabase variables below
# are not set, it automatically falls back to a local SQLite file at
# ./data/tradeparency.db. This is great for local development, but SQLite's
# file will NOT persist reliably on serverless platforms like Vercel because
# the filesystem is ephemeral between invocations.
#
# For any real deployment (including Vercel), set these two variables to
# point at a Supabase project and run supabase/schema.sql against it first.

# Your Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase service role key (Project Settings -> API -> service_role).
# This is used SERVER-SIDE ONLY (in API routes / server components) to write
# and read event data. Never expose this key to the browser or prefix it
# with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
